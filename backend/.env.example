# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Admin panel seed (optional). Creates admins row on first boot if missing.
# Sign in at frontend /admin/login — not linked from the user app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / Aiven)
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=expense_tracker
DB_PORT=3306
# DB_CA_CERT=optional_aiven_ca_certificate

# Comma-separated browser origins allowed in production (required when NODE_ENV=production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Voice expense extraction
# Use mock only for local UI development; production rejects it.
LLM_PROVIDER=mock
VOICE_ALLOW_MOCK=true
LLM_MODEL=replace_with_provider_model_id
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=1

# Configure only the credential for LLM_PROVIDER:
# GEMINI_API_KEY=
# COHERE_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=optional_openai_compatible_base_url
